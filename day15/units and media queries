<!DOCTYPE html>
<html>
<head>
    <title>Day 15 - CSS Units & Media Queries</title>

    <style>

        /* Task 1: 80% width, maximum 600px */
        .box {
            width: 80%;
            max-width: 600px;
            padding: 20px;
            margin: 20px auto;
            background-color: lightblue;
            text-align: center;
        }

        /* Task 2: REM font size */
        .rem-text {
            font-size: 1.5rem;
        }

        /* Task 3: VW heading */
        .vw-heading {
            font-size: 5vw;
            text-align: center;
        }

        /* Task 4: Different font families and sizes */
        .font1 {
            font-family: Arial, sans-serif;
            font-size: 20px;
        }

        .font2 {
            font-family: Georgia, serif;
            font-size: 24px;
        }

        .font3 {
            font-family: "Courier New", monospace;
            font-size: 18px;
        }

        /* Grid for Task 7 */
        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .grid div {
            background-color: lightgreen;
            padding: 30px;
            text-align: center;
        }

        /* Task 5: Below 768px */
        @media (max-width: 767px) {
            body {
                background-color: lightyellow;
            }
        }

        /* Task 6: Different devices */

        /* Tablet */
        @media (min-width: 768px) and (max-width: 1023px) {
            body {
                background-color: lightpink;
            }
        }

        /* Desktop */
        @media (min-width: 1024px) {
            body {
                background-color: lightblue;
            }
        }

        /* Task 7: 1 column - Mobile */
        @media (max-width: 767px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }

        /* 2 columns - Tablet */
        @media (min-width: 768px) and (max-width: 1023px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* 4 columns - Desktop */
        @media (min-width: 1024px) {
            .grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

    </style>
</head>

<body>

    <h1 class="vw-heading">CSS Units & Media Queries</h1>

    <!-- Task 1 -->
    <h2>Task 1: 80% Width</h2>
    <div class="box">
        This box takes 80% of the screen width,
        but maximum width is 600px.
    </div>

    <!-- Task 2 -->
    <h2>Task 2: REM Unit</h2>
    <p class="rem-text">
        This paragraph has a font size of 1.5rem.
    </p>

    <!-- Task 3 -->
    <h2>Task 3: VW Unit</h2>
    <h1 class="vw-heading">Responsive Heading</h1>

    <!-- Task 4 -->
    <h2>Task 4: Different Fonts</h2>

    <p class="font1">This text uses Arial font.</p>
    <p class="font2">This text uses Georgia font.</p>
    <p class="font3">This text uses Courier New font.</p>

    <!-- Task 5 & 6 -->
    <h2>Task 5 & 6: Media Queries</h2>
    <p>
        Resize the browser window to see the background color change.
    </p>

    <!-- Task 7 -->
    <h2>Task 7: Responsive Grid</h2>

    <div class="grid">
        <div>Box 1</div>
        <div>Box 2</div>
        <div>Box 3</div>
        <div>Box 4</div>
        <div>Box 5</div>
        <div>Box 6</div>
        <div>Box 7</div>
        <div>Box 8</div>
    </div>

</body>
</html>
