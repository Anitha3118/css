/* Element Selector */
/* Selects all <p> elements */
p {
    color:blueviolet;
    line-height: 1.6;
}

/* Class Selector */
/* Selects elements with class="intro" */
.intro {
    font-style: italic;
}

/* Class Selector */
/* Selects elements with class="highlight" */
.highlight {
    background-color: palegreen;
    padding: 8px;
}

/* ID Selector */
/* Selects the element with id="header" */
#header {
    color:peru;
    font-size: 32px;
}

/* Class Selector */
/* Selects elements with class="box" */
.box {
    border: 1px solid lightcoral;
    padding: 16px;
}
